{
  "name": "learnmate-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic AI-powered personalized learning pathway platform built with IBM Granite, watsonx.ai, and Langflow.",
  "scripts": {
    "dev": "node scripts/start-all.js",
    "dev:all": "node scripts/start-all.js",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run preview"
  }
}
